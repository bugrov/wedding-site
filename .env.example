# Copy to .env and adjust for your environment.

# Postgres connection string. For local dev via `docker compose up db`, this matches
# the credentials in docker-compose.yml (localhost:5433 from the host).
DATABASE_URL="postgresql://wedding:wedding_dev_password@localhost:5433/wedding?schema=public"

# Random long string used to sign admin session cookies. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# Telegram bot token from @BotFather, used for RSVP notifications to clients.
TELEGRAM_BOT_TOKEN=""

# The same bot's @username (no @), used to build the client dashboard's
# "Подключить Telegram" deep link (t.me/<username>?start=<token>).
TELEGRAM_BOT_USERNAME=""

# Optional: base URL for outgoing Telegram Bot API calls. Leave unset to use
# api.telegram.org directly (fine for local dev). Set this to a Cloudflare
# Worker proxy URL in prod if the VPS network can't reach api.telegram.org
# directly (see lib/telegram/index.ts).
TELEGRAM_API_BASE_URL=""

# Public base domain the app is served from (used for building subdomain links).
# Local dev: lvh.me (resolves to 127.0.0.1). Prod: your real domain.
APP_BASE_DOMAIN="lvh.me:3000"

# S3-compatible object storage (Selectel Object Storage) for photo uploads.
# Leave unset to disable uploads — the manual URL field still works either way.
S3_ENDPOINT="https://s3.ru-6.storage.selcloud.ru"
S3_REGION="ru-6"
S3_BUCKET="wedding-press-media"
# Per-bucket public read domain from the Selectel panel (not the API endpoint above).
S3_PUBLIC_URL="https://<bucket-uuid>.selstorage.ru"

# Separate PRIVATE bucket for scripts/backup-db.sh — on Selectel, "public"
# read access is a whole-bucket setting that ignores per-object ACLs, so
# backups (guest PII, password hashes) can never share a bucket with public
# media. Same S3 credentials above need access to this bucket too.
S3_BACKUP_BUCKET="wedding-press-backups"
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
