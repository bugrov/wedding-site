// Wedding site builder — data model. See the project plan
// (zazzy-stargazing-sundae.md) for the full rationale behind each table.

generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// Single-row table: one operator account, session-based auth (not JWT — see plan).
model AdminUser {
  id           String         @id @default(cuid())
  email        String         @unique
  passwordHash String         @map("password_hash")
  createdAt    DateTime       @default(now()) @map("created_at")
  sessions     AdminSession[]

  @@map("admin_users")
}

// DB-backed session (not a stateless JWT) so logout/revocation is immediate —
// the session row is deleted, not just the cookie cleared client-side.
model AdminSession {
  id          String    @id @default(cuid())
  adminUserId String    @map("admin_user_id")
  adminUser   AdminUser @relation(fields: [adminUserId], references: [id], onDelete: Cascade)
  expiresAt   DateTime  @map("expires_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("admin_sessions")
}

enum LeadStatus {
  NEW // новая
  IN_PROGRESS // в работе (converted to a project)
  REJECTED // отклонена

  @@map("lead_status")
}

// A public-configurator submission: block/template/theme picks + contact info.
// Not a site yet — the operator manually turns this into a Project.
model Lead {
  id           String     @id @default(cuid())
  createdAt    DateTime   @default(now()) @map("created_at")
  contactName  String     @map("contact_name")
  groomName    String     @map("groom_name")
  brideName    String     @map("bride_name")
  weddingDate  DateTime   @map("wedding_date")
  phone        String
  telegram     String?
  comment      String?
  templateId   String     @map("template_id") // references the code-level template registry, not a DB row
  themeId      String?    @map("theme_id")
  theme        Theme?     @relation(fields: [themeId], references: [id])
  blocksConfig Json       @map("blocks_config")
  status       LeadStatus @default(NEW)
  project      Project?

  @@index([themeId])
  @@map("leads")
}

enum ProjectStatus {
  IN_PROGRESS // в работе
  IN_REVIEW // на согласовании
  PAID // оплачено (marked manually — payment happens outside the system)
  PUBLISHED // опубликован
  CANCELLED // отменено

  @@map("project_status")
}

// A real client site. Rendered by subdomain (`slug`) via middleware.
model Project {
  id                String         @id @default(cuid())
  leadId            String?        @unique @map("lead_id")
  lead              Lead?          @relation(fields: [leadId], references: [id])
  slug              String         @unique
  groomName         String         @map("groom_name")
  brideName         String         @map("bride_name")
  weddingDate       DateTime       @map("wedding_date")
  templateId        String         @map("template_id")
  themeId           String?        @map("theme_id")
  theme             Theme?         @relation(fields: [themeId], references: [id])
  blocksConfig      Json           @map("blocks_config")
  status            ProjectStatus  @default(IN_PROGRESS)
  clientAccessToken String         @unique @map("client_access_token")
  telegramChatId    String?        @map("telegram_chat_id")
  createdAt         DateTime       @default(now()) @map("created_at")
  publishedAt       DateTime?      @map("published_at")
  guests            Guest[]
  rsvpResponses     RsvpResponse[]

  @@index([themeId])
  @@map("projects")
}

// A color scheme scoped to one template_id. Admin-editable, no code/deploy needed.
model Theme {
  id            String    @id @default(cuid())
  templateId    String    @map("template_id")
  name          String
  colorTokens   Json      @map("color_tokens")
  fontPair      String    @map("font_pair")
  decorOverride String?   @map("decor_override")
  leads         Lead[]
  projects      Project[]

  @@map("themes")
}

model Guest {
  id                String         @id @default(cuid())
  projectId         String         @map("project_id")
  project           Project        @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name              String
  personalLinkToken String?        @unique @map("personal_link_token")
  rsvpResponses     RsvpResponse[]

  @@index([projectId])
  @@map("guests")
}

model RsvpResponse {
  id          String   @id @default(cuid())
  projectId   String   @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  guestId     String?  @map("guest_id")
  guest       Guest?   @relation(fields: [guestId], references: [id], onDelete: SetNull)
  name        String
  attending   Boolean
  headcount   Int      @default(1)
  foodPref    String?  @map("food_pref")
  drinkPref   String?  @map("drink_pref")
  plusOneName String?  @map("plus_one_name")
  comment     String?
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([projectId])
  @@index([guestId])
  @@map("rsvp_responses")
}
